{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a6gp.dev/schema/action-v0.4.json",
  "title": "A6GP Action v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionId","contractId","contractRevision","tenant","actor","targetAuthorityDomain","targetScope","actionType","parameters","riskClass","timingClass","idempotencyKey","topologyVersion","policyVersion","preconditionSnapshotHash"],
  "properties": {
    "actionId":{"type":"string"}, "contractId":{"type":"string"}, "contractRevision":{"type":"integer","minimum":1},
    "tenant":{"type":"string"}, "actor":{"type":"string"}, "targetAuthorityDomain":{"type":"string"},
    "targetScope":{"type":"string"}, "actionType":{"type":"string"}, "parameters":{"type":"object"},
    "riskClass":{"enum":["R0","R1","R2","R3"]}, "timingClass":{"enum":["T0","T1","T2","T3","T4"]},
    "idempotencyKey":{"type":"string"}, "topologyVersion":{"type":"string"}, "policyVersion":{"type":"string"},
    "preconditionSnapshotHash":{"type":"string"}, "fallbackPolicy":{"type":"string"}, "compensationActionType":{"type":"string"}
  }
}
