{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a6gp.dev/schema/authority-lease-v0.4.json",
  "title": "A6GP Authority Lease v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["leaseId","subject","tenant","scope","actionSet","riskCeiling","validUntil","constraints","nonce","issuedAt","chainHash"],
  "properties": {
    "leaseId":{"type":"string"}, "subject":{"type":"string"}, "tenant":{"type":"string"},
    "scope":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "actionSet":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "riskCeiling":{"enum":["R0","R1","R2","R3"]},
    "validUntil":{"type":"string","format":"date-time"},
    "parentLeaseId":{"type":"string"}, "parentChainHash":{"type":"string"},
    "constraints":{"type":"array","items":{"type":"string"}}, "nonce":{"type":"string"},
    "issuedAt":{"type":"string","format":"date-time"}, "revokedAt":{"type":"string","format":"date-time"},
    "chainHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
