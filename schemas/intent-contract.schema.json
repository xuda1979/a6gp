{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a6gp.dev/schema/intent-contract-v0.4.json",
  "title": "A6GP Intent Contract v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId","revision","tenant","goal","scope","hardConstraints","allowedActions","riskClass","timingClass","evidencePolicy","minimumEvidenceStrength","minimumIndependentSources","fallbackPolicy","validUntil","state"],
  "properties": {
    "contractId": {"type":"string","minLength":1},
    "revision": {"type":"integer","minimum":1},
    "tenant": {"type":"string","minLength":1},
    "goal": {"type":"string","minLength":1},
    "scope": {"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "hardConstraints": {"type":"array","items":{"type":"string"}},
    "allowedActions": {"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "riskClass": {"enum":["R0","R1","R2","R3"]},
    "timingClass": {"enum":["T0","T1","T2","T3","T4"]},
    "evidencePolicy": {"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "minimumEvidenceStrength": {"type":"number","exclusiveMinimum":0,"maximum":1},
    "minimumIndependentSources": {"type":"integer","minimum":1},
    "approvalThreshold": {"type":"integer","minimum":1},
    "fallbackPolicy": {"type":"string","minLength":1},
    "validUntil": {"type":"string","format":"date-time"},
    "state": {"enum":["PROPOSED","NEGOTIATING","ADMITTED","ACTIVE","VERIFYING","COMPLETED","DEGRADED","RECOVERING","ABORTING","ABORTED","EXPIRED","REJECTED"]}
  }
}
