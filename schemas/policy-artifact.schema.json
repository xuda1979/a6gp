{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a6gp.dev/schema/policy-artifact-v0.4.json",
  "title": "A6GP Fast Policy Artifact v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId","artifactHash","tenant","targetScope","topologyVersion","policyVersion","timingClass","validFrom","validUntil","inputEnvelope","actionEnvelope","guardConditions","fallback","rollbackPolicy","verificationEvidence"],
  "properties": {
    "artifactId":{"type":"string"}, "artifactHash":{"type":"string"}, "tenant":{"type":"string"}, "targetScope":{"type":"string"},
    "topologyVersion":{"type":"string"}, "policyVersion":{"type":"string"}, "timingClass":{"enum":["T0","T1"]},
    "validFrom":{"type":"string","format":"date-time"}, "validUntil":{"type":"string","format":"date-time"},
    "inputEnvelope":{"type":"object"}, "actionEnvelope":{"type":"object"}, "guardConditions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "fallback":{"type":"string","minLength":1}, "rollbackPolicy":{"type":"string","minLength":1},
    "verificationEvidence":{"type":"array","minItems":1,"items":{"type":"string"}}
  }
}
